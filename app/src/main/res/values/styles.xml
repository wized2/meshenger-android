<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Shape.Meshenger.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Meshenger.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.Meshenger.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ButtonStyle" parent="@android:style/Widget.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:fontFamily">@font/lato_bold</item>
    </style>
    <style name="ButtonColorFireRed" parent="ButtonStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">#FFEC3E3E</item>
    </style>
    <style name="ButtonColorGrassGreen" parent="ButtonStyle">
        <item name="android:textColor">#E2FFC1</item>
        <item name="android:backgroundTint">#3C983F</item>
    </style>
    <style name="ButtonColorSkyBlue" parent="ButtonStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">#1C6FB7</item>
    </style>
    <style name="ButtonColorNightGrey" parent="ButtonStyle">
        <item name="android:textColor">@color/light_grey</item>
        <item name="android:backgroundTint">@color/dark_grey</item>
    </style>

    <style name="Widget.Meshenger.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/m3_surface</item>
    </style>

    <style name="Widget.Meshenger.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/m3_surface_container</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Meshenger.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="borderWidth">0dp</item>
    </style>

    <style name="CurvedImageViewStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12%</item>
    </style>

    <style name="CustomTabTextStyle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/headline_text_size</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ListView dropdown — no theme attrs (inflate-safe) -->
    <style name="MySpinner" parent="@android:style/Widget.ListView.DropDown">
        <item name="android:dividerHeight">1dp</item>
        <item name="android:divider">@color/m3_outline_variant</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="Widget.Meshenger.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/m3_popup_background</item>
    </style>
    <style name="Widget.Meshenger.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/m3_popup_background</item>
    </style>
    <style name="ThemeOverlay.Meshenger.Popup" parent="ThemeOverlay.Material3">
        <item name="android:colorBackground">@color/m3_surface_container_high</item>
        <item name="colorSurface">@color/m3_surface_container_high</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="popupMenuBackground">@drawable/m3_popup_background</item>
    </style>
</resources>
