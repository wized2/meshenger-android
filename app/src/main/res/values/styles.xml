<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Expressive M3 shape scale -->
    <style name="Shape.Meshenger.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Meshenger.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape.Meshenger.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Meshenger.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ButtonStyle" parent="Widget.Meshenger.Button" />

    <style name="ButtonColorFireRed" parent="ButtonStyle">
        <item name="backgroundTint">@color/seed_fire</item>
        <item name="android:textColor">@color/seed_fire_on</item>
    </style>
    <style name="ButtonColorGrassGreen" parent="ButtonStyle">
        <item name="backgroundTint">@color/seed_grass</item>
        <item name="android:textColor">@color/seed_grass_on</item>
    </style>
    <style name="ButtonColorSkyBlue" parent="ButtonStyle">
        <item name="backgroundTint">@color/seed_sky</item>
        <item name="android:textColor">@color/seed_sky_on</item>
    </style>
    <style name="ButtonColorNightGrey" parent="ButtonStyle">
        <item name="backgroundTint">@color/seed_grey</item>
        <item name="android:textColor">@color/seed_grey_on</item>
    </style>

    <style name="CurvedImageViewStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16%</item>
    </style>

    <style name="CustomTabTextStyle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/headline_text_size</item>
        <item name="android:fontFamily">@font/lato_bold</item>
    </style>

    <style name="MySpinner" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:dividerHeight">1dp</item>
        <item name="android:divider">@color/m3_outline_variant</item>
    </style>
</resources>
