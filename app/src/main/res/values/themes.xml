        <item name="android:textColorSecondary">@color/seed_fire</item>
        <item name="android:buttonStyle">@style/ButtonColorFireRed</item>
        <item name="selectedColor">@color/seed_fire</item>
        <item name="unselectedColor">@color/seed_fire_container</item>
        <item name="callButtonBackgroundColor">@color/seed_fire</item>
        <item name="tabColor">@color/seed_fire_container</item>
        <item name="tabTextColor">@color/seed_fire_on_container</item>
        <item name="tabSelectedColor">@color/seed_fire</item>
